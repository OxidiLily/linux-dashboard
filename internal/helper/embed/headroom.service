[Unit]
Description=Headroom proxy — lapisan kompresi konteks untuk Token Saver 9router
Documentation=https://github.com/headroomlabs-ai/headroom
# 9router memulai proxy-nya sendiri: systemd hanyalah lapisan ketahanan.
# Unit dijalankan oleh 9router (lihat internal/helper/aitools.go:rebutHeadroomDari9router)
# dan dihapus saat 9router berhenti, sehingga `systemctl restart headroom.service` tidak pernah dipanggil oleh panel.
After=network-online.target
PartOf=9router.service
BindsTo=9router.service
Before=9router.service

[Service]
Type=simple
ExecStart=/opt/headroom/bin/headroom proxy --host 127.0.0.1 --port 8787
# 9router menentukan proxy hidup/mati lewat ~/.9router/headroom/proxy.pid (kill - TERM/KILL).
# Unit ini HANYA menulis pid file untuk systemd: ExecStartPost membuat file,
# ExecStop menghapusnya — 9router juga menghapus miliknya saat berhenti.
ExecStartPost=/bin/sh -c 'install -d -m 0755 "$HOME/.9router/headroom" && printf "$MAINPID\n" > "$HOME/.9router/headroom/proxy.pid"'
ExecStopPost=/bin/sh -c 'rm -f "$HOME/.9router/headroom/proxy.pid"'
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
# Jalankan sebagai user panel yang sama dengan 9router (via drop-in 10-user.conf).
# drop-in ditulis di internal/helper/aitools.go:pastikanUserHeadroom.
Environment=HOME=/root
Environment=HEADROOM_TELEMETRY=off
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target