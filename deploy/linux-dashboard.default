# Setelan per-device linux-dashboard.
#
# Berkas ini dibaca unit systemd lewat EnvironmentFile dan TIDAK PERNAH ditimpa
# installer maupun tombol Update — semua yang diubah di sini bertahan melewati
# pembaruan. Setelah mengubahnya:
#
#   systemctl restart linux-dashboard-web
#
# Alamat dengar. Kosongkan alamatnya (":1122") untuk semua interface.
#DASHBOARD_LISTEN=0.0.0.0:1122

# Cookie sesi hanya dikirim lewat koneksi terenkripsi. Menyala sendiri kalau
# TLS diisi di bawah. Yang perlu mengisinya secara manual hanya pemasangan di
# belakang reverse proxy (Caddy/Nginx/NPM), karena di situ panel tidak bisa
# tahu sisi luarnya HTTPS. Menyalakannya tanpa HTTPS membuat login mustahil:
# browser tidak akan pernah mengirim balik cookie-nya.
#DASHBOARD_SECURE_COOKIE=true

# TLS langsung di panel. BAWAANNYA MATI — panel berbicara HTTP polos, dan
# installer tidak lagi membuat sertifikat self-signed sendiri (sertifikat yang
# tidak ditandatangani CA mana pun hanya menghasilkan peringatan browser
# permanen di setiap perangkat).
#
# Isi dua baris ini untuk menyalakannya — sertifikat dari CA internal, Let's
# Encrypt, atau self-signed buatan sendiri. Berkasnya harus bisa dibaca user
# `linux-dashboard`. Sesudah diisi: systemctl restart linux-dashboard-web.
#DASHBOARD_TLS_CERT=/etc/ssl/certs/linux-dashboard.crt
#DASHBOARD_TLS_KEY=/etc/ssl/private/linux-dashboard.key
#
# Membuat sertifikat self-signed sendiri (ganti <ip> dengan alamat panel):
#   openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 3650 \
#     -subj "/CN=$(hostname)" -addext "subjectAltName=DNS:$(hostname),IP:<ip>" \
#     -keyout /etc/linux-dashboard/tls.key -out /etc/linux-dashboard/tls.crt

# Umur sesi login, dalam jam.
#DASHBOARD_SESSION_TTL_HOURS=12
